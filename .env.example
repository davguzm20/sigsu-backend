SPRING_PROFILES_ACTIVE=
MYSQL_HOST=
MYSQL_PORT=
MYSQL_DATABASE=
MYSQL_USERNAME=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_SECRET=
JWT_EXPIRATION_MS=
SIGSU_ADMIN_CORREO=
SIGSU_ADMIN_CONTRASENA=
CORS_ALLOWED_ORIGINS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Activar con SPRING_PROFILES_ACTIVE=dev,observability
# Prometheus recolectará métricas por pull; no necesita URL de exportación aquí.
# Mantener false hasta disponer de un receptor OTLP HTTP.
TRACING_EXPORT_ENABLED=false
OTLP_TRACES_ENDPOINT=http://host.docker.internal:4318/v1/traces
TRACING_SAMPLING_PROBABILITY=1.0

# Obligatorios con observability. Usar credenciales técnicas exclusivas.
METRICS_USERNAME=
METRICS_PASSWORD=

# Compose de observabilidad: puertos publicados solo en localhost.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
TEMPO_RETENTION=24h

# Alertas: editar observability/alerting/thresholds.json y ejecutar scripts/Build-AlertRules.ps1.
# Retención de métricas: storage.tsdb.retention.time en observability/prometheus.yml.
